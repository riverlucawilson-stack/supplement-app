---
// The frame around every page: page title and description for search
// engines, the header, the affiliate disclosure, and the "not medical
// advice" note. Because every page uses this layout, none can skip them.
import { categoryList } from '../categories';
import { settings } from '../settings';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const fullTitle = title === settings.siteName ? title : `${title} | ${settings.siteName}`;
const path = Astro.url.pathname;
const samePage = (href: string) => path.replace(/\/$/, '') === href.replace(/\/$/, '');
// One menu link per published category. Its product and evidence pages count as "inside" it.
const nav = categoryList.filter((c) => c.published).map((c) => ({ href: c.path, label: c.name }));
const inside = (href: string) => path === href || path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600;700&family=Schibsted+Grotesk:wght@400;500;600;700;800&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/" aria-label={`${settings.siteName} home`}>
          <svg class="mark" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <rect x="1.5" y="1.5" width="21" height="21" rx="6" fill="currentColor" />
            <path d="M7 12.5l3.2 3.2L17 8.8" fill="none" stroke="var(--surface)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Sup<span>Search</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <details class="menu">
            <summary aria-current={nav.some((n) => inside(n.href)) ? 'true' : undefined}>Categories</summary>
            <div class="menu-panel">
              <ul>
                {nav.map((n) => (
                  <li><a href={n.href} aria-current={samePage(n.href) ? 'page' : inside(n.href) ? 'true' : undefined}>{n.label}</a></li>
                ))}
              </ul>
            </div>
          </details>
          <a href="/methodology/" aria-current={samePage('/methodology/') ? 'page' : undefined}>Methodology</a>
        </nav>
      </div>
    </header>

    <aside class="notice" aria-label="Disclosures">
      <div class="wrap">
        <p>
          <strong>No affiliate links.</strong> We don't earn commissions from any link on this site.
        </p>
        <p><strong>Not medical advice.</strong> Talk to a qualified professional before starting a supplement.</p>
      </div>
    </aside>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-grid">
          <div class="foot-about">
            <a class="wordmark" href="/">Sup<span>Search</span></a>
            <p>
              An independent comparison of supplements by what they cost per dose and how much of their lab testing you
              can see. Rankings come only from the formula on our <a href="/methodology/">Methodology</a> page.
            </p>
            <p>No affiliate links, no sponsored placements. Not medical advice.</p>
          </div>
          <nav class="foot-links cats" aria-label="Categories">
            <p class="foot-head">Categories</p>
            <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
          </nav>
          <nav class="foot-links" aria-label="About the data">
            <p class="foot-head">About the data</p>
            <ul>
              <li><a href="/methodology/">Methodology</a></li>
              <li><a href="/methodology/#ingredient-grade">Ingredient grades</a></li>
            </ul>
          </nav>
        </div>
      </div>
    </footer>
    <script>
      // Close the Categories menu when clicking elsewhere or pressing Escape.
      const menu = document.querySelector<HTMLDetailsElement>('.site-nav .menu');
      if (menu) {
        document.addEventListener('click', (e) => {
          if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menu.open) {
            menu.open = false;
            menu.querySelector('summary')?.focus();
          }
        });
      }
    </script>
  </body>
</html>
