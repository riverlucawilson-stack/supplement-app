---
// One category's comparison page: every product in one table, cheapest per
// reference dose first (e.g. per 5 g of creatine). Visitors can sort and
// filter it. On phones each row becomes a card. Every number here is
// calculated in src/lib, never typed by hand.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryById, productPath, type CategoryId } from '../categories';
import { formLabels } from '../categories/shared';
import { settings } from '../settings';
import { bestPrice } from '../lib/pricing';
import { isCertificationCurrent } from '../lib/staleness';
import { usd } from '../lib/format';
import { tierFor } from '../lib/tier';
import { hasUnverifiedData, isSampleProduct } from '../lib/review';
import { evidenceFor } from '../evidence';

interface Props {
  categoryId: CategoryId;
}
const { categoryId } = Astro.props;
const today = new Date();
const category = categoryById(categoryId);
const { title, description, heading } = category.page;
// The intro is plain text from the category file; **words** become bold.
const escape = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const intro = escape(category.page.intro).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
const hasEvidence = evidenceFor(categoryId) !== undefined;

const rows = (await getCollection('products'))
  .filter((entry) => entry.data.category === categoryId)
  .map((entry) => {
    const p = entry.data;
    const best = bestPrice(p, today);
    const tier = tierFor(p, today);
    // Star rating: prefer the best-price store's, else the first store that has one.
    const rated = best?.price.rating ? best.price : p.prices.find((x) => x.rating);
    const currentCerts = p.certifications.filter((c) => isCertificationCurrent(c.date_verified, today));
    return {
      id: entry.id,
      href: productPath(entry.id, p),
      product: p,
      best,
      tier: tier.tier,
      certs: currentCerts.map((c) => c.program),
      coaCount: p.coas.length,
      rating: rated?.rating
        ? { ...rated.rating, retailer: rated.retailer, url: rated.rating.url ?? rated.url }
        : undefined,
      sample: isSampleProduct(p),
      unverified: hasUnverifiedData(p),
    };
  })
  // Cheapest first; products with no price go last.
  .sort((a, b) => (a.best?.costPerReferenceDose ?? Infinity) - (b.best?.costPerReferenceDose ?? Infinity));

const forms = [...new Set(rows.map((r) => r.product.form))].sort();
const shortDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const formLabel = formLabels;
const tierOrder = { A: 0, B: 1, C: 2 } as const;
const costLabel = category.referenceDose.short;
const costLabelLower = costLabel.charAt(0).toLowerCase() + costLabel.slice(1);
---

<BaseLayout title={title} description={description}>
  <section class="intro wrap">
    <p class="eyebrow">{category.name} · {rows.length} products</p>
    <h1>{heading}</h1>
    <p class="lede" set:html={intro} />
    {hasEvidence && (
      <p class="research"><a href={category.evidencePath}>What the research says about {category.name.charAt(0).toLowerCase() + category.name.slice(1)} →</a></p>
    )}
  </section>

  <section class="wrap" aria-label="Comparison table">
    <form class="controls" id="controls" aria-label="Sort and filter">
      <label class="control">
        <span>Sort by</span>
        <select id="sort" name="sort">
          <option value="cost-asc">{costLabel}, low to high</option>
          <option value="cost-desc">{costLabel}, high to low</option>
          <option value="tier">Tier, A first</option>
        </select>
      </label>

      <fieldset class="control chips">
        <legend>Tier</legend>
        {
          ['A', 'B', 'C'].map((t) => (
            <label class="chip">
              <input type="checkbox" name="tier" value={t} checked id={`tier-${t}`} />
              <span>{t}</span>
            </label>
          ))
        }
      </fieldset>

      <fieldset class="control chips">
        <legend>Form</legend>
        {
          forms.map((f) => (
            <label class="chip">
              <input type="checkbox" name="form" value={f} checked id={`form-${f}`} />
              <span>{formLabel[f] ?? f}</span>
            </label>
          ))
        }
      </fieldset>

      <label class="chip chip-toggle">
        <input type="checkbox" id="certified-only" name="certified" />
        <span>Certified only</span>
      </label>
    </form>

    <div class="table-scroll">
      <table class="compare" id="compare">
        <thead>
          <tr>
            <th scope="col">Product</th>
            <th scope="col" class="r">{costLabel}</th>
            {category.daily && <th scope="col" class="r">30 days</th>}
            <th scope="col">Best price</th>
            <th scope="col" class="c">Tier</th>
            <th scope="col">Testing</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr
                data-cost={r.best?.costPerReferenceDose ?? ''}
                data-tier={r.tier}
                data-tier-order={tierOrder[r.tier]}
                data-form={r.product.form}
                data-certified={r.certs.length > 0 ? 'yes' : 'no'}
              >
                <th scope="row" class="product">
                  <div class="product-inner">
                  <span class="brand">{r.product.brand}</span>
                  {r.href ? (
                    <a class="name" href={r.href}>{r.product.name}</a>
                  ) : (
                    <span class="name">{r.product.name}</span>
                  )}
                  <span class="meta">
                    {formLabel[r.product.form]} · {category.describe(r.product)}
                  </span>
                  {r.rating && (
                    <a class="rating" href={r.rating.url} rel="noopener" target="_blank">
                      <span class="stars" aria-hidden="true">★</span>
                      <span class="num">{r.rating.stars.toFixed(1)}</span>
                      <span class="rating-count">
                        {r.rating.count.toLocaleString('en-US')} reviews at {r.rating.retailer}
                      </span>
                    </a>
                  )}
                  {(r.sample || r.unverified) && (
                    <span class="tags">
                      {r.sample && <span class="pill pill-muted">Sample data</span>}
                      {r.unverified && <span class="pill pill-warn">Not yet reviewed</span>}
                    </span>
                  )}
                  </div>
                </th>
                <td class="r cost" data-label={costLabel} data-per={category.referenceDose.label}>
                  {r.best ? <span class="num big">{usd(r.best.costPerReferenceDose)}</span> : <span class="none">No price</span>}
                </td>
                {category.daily && (
                  <td class="r" data-label={category.daily.label}>
                    {r.best?.costPer30Days !== undefined ? <span class="num">{usd(r.best.costPer30Days)}</span> : <span class="none">–</span>}
                  </td>
                )}
                <td class="where" data-label="Best price">
                  {r.best ? (
                    <>
                      <a href={r.best.price.url} rel="sponsored noopener" target="_blank">
                        {r.best.price.retailer}
                      </a>
                      <span class="sub num">
                        {usd(r.best.price.price_usd)} / {r.best.price.servings} servings
                      </span>
                      <span class="sub">
                        Checked {shortDate(r.best.price.date_checked)}
                        {r.best.stale && <span class="pill pill-warn">Stale</span>}
                      </span>
                    </>
                  ) : (
                    <span class="none">–</span>
                  )}
                </td>
                <td class="c" data-label="Tier">
                  <span class={`tier tier-${r.tier}`} title={`Tier ${r.tier}`}>
                    {r.tier}
                  </span>
                </td>
                <td class="testing" data-label="Testing">
                  <span>{r.certs.length > 0 ? r.certs.join(', ') : <span class="none">No current certification</span>}</span>
                  <span class="sub">
                    {r.coaCount === 0 ? 'No COA found' : r.coaCount === 1 ? '1 COA' : `${r.coaCount} COAs`}
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="empty" id="empty" hidden>No products match these filters.</p>
    </div>
  </section>

  <section class="wrap legend" aria-label="What the tiers mean">
    <h2>What the tiers mean</h2>
    <dl>
      <div>
        <dt><span class="tier tier-A">A</span></dt>
        <dd>
          A current third-party certification <em>and</em> a COA from an ISO/IEC 17025 accredited lab, testing the
          finished product, less than {settings.coaStaleAfterYears} years old.
        </dd>
      </div>
      <div>
        <dt><span class="tier tier-B">B</span></dt>
        <dd>Some proof of testing (a COA or a certification), but not everything Tier A needs.</dd>
      </div>
      <div>
        <dt><span class="tier tier-C">C</span></dt>
        <dd>No COA and no certification found.</dd>
      </div>
    </dl>
    <p class="fine">
      Prices are read from each store's own page and marked stale after {settings.priceStaleAfterDays} days. A certification counts
      only if it appears on the certifier's own website. Star ratings are each store's own customer reviews, shown
      for reference; they never affect the order of the table.
    </p>
  </section>
</BaseLayout>

<script>
  // Sorting and filtering happen in the visitor's browser. No data leaves the page.
  const form = document.getElementById('controls') as HTMLFormElement;
  const tbody = document.querySelector('#compare tbody') as HTMLTableSectionElement;
  const empty = document.getElementById('empty') as HTMLElement;
  const rows = Array.from(tbody.querySelectorAll('tr'));

  const costOf = (r: HTMLElement) => (r.dataset.cost ? Number(r.dataset.cost) : Infinity);

  function update() {
    const data = new FormData(form);
    const tiers = new Set(data.getAll('tier'));
    const forms = new Set(data.getAll('form'));
    const certifiedOnly = data.has('certified');
    const sort = data.get('sort');

    const sorted = [...rows].sort((a, b) => {
      if (sort === 'cost-desc') {
        // Products without a price stay at the bottom either way.
        const ca = costOf(a), cb = costOf(b);
        if (ca === Infinity || cb === Infinity) return ca - cb;
        return cb - ca;
      }
      if (sort === 'tier') {
        return Number(a.dataset.tierOrder) - Number(b.dataset.tierOrder) || costOf(a) - costOf(b);
      }
      return costOf(a) - costOf(b);
    });

    let shown = 0;
    for (const r of sorted) {
      const visible =
        tiers.has(r.dataset.tier!) && forms.has(r.dataset.form!) && (!certifiedOnly || r.dataset.certified === 'yes');
      r.hidden = !visible;
      if (visible) shown++;
      tbody.appendChild(r);
    }
    empty.hidden = shown > 0;
  }

  form.addEventListener('change', update);
  form.addEventListener('submit', (e) => e.preventDefault());
</script>

<style>
  .intro {
    padding-block: 2.5rem 1.5rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h1 {
    margin: 0;
    max-width: 22ch;
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    font-weight: 800;
  }

  .lede {
    max-width: 62ch;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 1.0625rem;
  }

  .research {
    margin: 0.75rem 0 0;
    font-weight: 600;
  }

  .lede strong {
    color: var(--ink);
  }

  /* ---------- Controls ---------- */
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem 1.5rem;
    padding: 1rem;
    margin-bottom: 1rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .control {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .control > span,
  .control legend {
    padding: 0;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .control select {
    font: inherit;
    font-size: 0.9rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--paper);
    color: var(--ink);
  }

  .chips {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .chips legend {
    margin-bottom: 0.35rem;
  }

  .chip {
    position: relative;
    display: inline-flex;
  }

  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .chip span {
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
    background: var(--paper);
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }

  .chip input:checked + span {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--ink);
  }

  .chip input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .chip-toggle {
    align-self: end;
  }

  /* ---------- Table ---------- */
  .table-scroll {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow-x: auto;
  }

  .compare {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .compare thead th {
    position: sticky;
    top: 0;
    padding: 0.75rem 1rem;
    background: var(--surface);
    border-bottom: 2px solid var(--ink);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: left;
    color: var(--muted);
    white-space: nowrap;
  }

  .compare td,
  .compare tbody th {
    padding: 1rem;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
    text-align: left;
    font-weight: 400;
  }

  .compare tbody tr:last-child > * {
    border-bottom: 0;
  }

  .compare .r {
    text-align: right;
  }

  .compare .c {
    text-align: center;
  }

  .product {
    min-width: 13rem;
  }

  .product-inner {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .brand {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .name {
    font-weight: 700;
    font-size: 1rem;
  }

  a.name {
    color: var(--ink);
  }

  .meta,
  .sub {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .sub {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .rating {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    margin-top: 0.3rem;
    font-size: 0.8125rem;
    color: var(--ink);
    text-decoration: none;
  }

  .rating:hover .rating-count {
    text-decoration: underline;
  }

  .stars {
    color: var(--tier-b);
  }

  .rating .num {
    font-weight: 600;
  }

  .rating-count {
    color: var(--muted);
  }

  .tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-top: 0.4rem;
  }

  .big {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .where,
  .testing {
    display: table-cell;
  }

  .where a {
    font-weight: 600;
  }

  .where > *,
  .testing > * {
    display: block;
  }

  .where .sub,
  .testing .sub {
    display: flex;
  }

  .none {
    color: var(--muted);
    font-style: italic;
  }

  .empty {
    margin: 0;
    padding: 2rem 1rem;
    text-align: center;
    color: var(--muted);
  }

  /* Phones: each row becomes a card. */
  @media (max-width: 720px) {
    .table-scroll {
      background: none;
      border: 0;
      overflow: visible;
    }

    .compare thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .compare,
    .compare tbody {
      display: block;
    }

    .compare tbody tr {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.75rem 1rem;
      margin-bottom: 0.75rem;
      padding: 1rem;
      background: var(--surface);
      border: 1px solid var(--rule);
      border-radius: var(--radius);
    }

    .compare tbody tr[hidden] {
      display: none;
    }

    .compare td,
    .compare tbody th {
      padding: 0;
      border: 0;
      min-width: 0;
    }

    .product {
      grid-column: 1;
      grid-row: 1;
    }

    .compare td.c {
      grid-column: 2;
      grid-row: 1;
    }

    .compare td.cost {
      grid-column: 1 / -1;
      text-align: left;
    }

    .compare td.cost::after {
      content: ' ' attr(data-per);
      font-size: 0.8125rem;
      color: var(--muted);
    }

    .compare td:not(.cost):not(.c) {
      grid-column: 1 / -1;
      text-align: left;
      display: grid;
      grid-template-columns: 7.5rem 1fr;
      gap: 0.5rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--rule);
    }

    .compare td:not(.cost):not(.c)::before {
      content: attr(data-label);
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .compare td.where > *,
    .compare td.testing > * {
      grid-column: 2;
    }

    .big {
      font-size: 1.75rem;
    }
  }

  /* ---------- Legend ---------- */
  .legend {
    padding-block: 2.5rem 0;
  }

  .legend h2 {
    margin: 0 0 1rem;
    font-size: 1.25rem;
  }

  .legend dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
    margin: 0;
  }

  .legend dl > div {
    display: flex;
    gap: 0.75rem;
    align-items: start;
  }

  .legend dt {
    flex: none;
  }

  .legend dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .fine {
    margin: 1.5rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
